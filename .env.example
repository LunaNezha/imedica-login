# All VITE_* values are public build-time configuration. Never put secrets here.
VITE_API_BASE_URL=/api
# Optional public application root, e.g. https://example.com/imedica/.
# Sets canonical/OG URLs and absolute social image URLs; keep aligned with Vite base.
VITE_SITE_URL=
# Fallback language; a saved preference or supported browser language takes priority.
VITE_DEFAULT_LANGUAGE=en
# These flags are development-only, even if true in a production build.
VITE_ENABLE_MOCK_AUTH=true
VITE_ENABLE_DEVTOOLS=true
# Public demo credentials, NOT real accounts. No SMS is sent.
VITE_MOCK_USERNAME=demo@imedica.app
VITE_MOCK_PASSWORD=Demo123!
VITE_MOCK_PHONE=09122223333
VITE_MOCK_OTP=012345
VITE_MOCK_LATENCY_MS=650
# Optional legacy browser/WebView bundles (increases output size).
VITE_LEGACY_BUILD=false
